---
import BaseLayout from "../layouts/BaseLayout.astro";

const streamUid = "a16f43a031018d26013ca4ec9797c73f";
const customerCode = "nrvbnzpd60zikmrq";
const iframeSrc = `https://customer-${customerCode}.cloudflarestream.com/${streamUid}/iframe?autoplay=true&muted=false`;
---

<BaseLayout
  title="Yarbrough Wedding — Justin Rosengarten"
  description="Yarbrough Wedding film by Justin Rosengarten."
  canonical="https://justinrosengarten.com/yarbrough-wedding"
>
  <main class="main">
    <div class="player-wrap">
      <iframe
        src={iframeSrc}
        allow="autoplay; fullscreen; picture-in-picture"
        allowfullscreen
        class="player"
        title="Yarbrough Wedding"
      ></iframe>
    </div>
  </main>
</BaseLayout>

<style>
  .main {
    padding-top: 88px;
  }

  .player-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    background: #000;
  }

  .player {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  @media (max-width: 768px) {
    .main {
      padding-top: 60px;
    }
  }
</style>
