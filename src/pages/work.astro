---
import BaseLayout from "../layouts/BaseLayout.astro";
import VideoCard from "../components/VideoCard.astro";
---

<BaseLayout
  title="Work — Justin Rosengarten"
  description="Selected work by Justin Rosengarten, documentary editor."
  canonical="https://justinrosengarten.com/work"
>
  <main class="main">
    <div class="grid">
      {Array.from({ length: 5 }).map(() => (
        <div class="placeholder" aria-hidden="true" />
      ))}
      <VideoCard
        mp4="/Motion%20Thumbs/BAKING_MOTION-THUMB.mp4"
        poster="https://imagedelivery.net/LngsP1G4XrZYr43CIDhlJw/f57ac85a-07f9-46a9-c923-3dddf8455500/public"
        href="/baking"
        title="Baking"
      />
      <VideoCard
        mp4="/Motion%20Thumbs/CHULENGO-MOTION-THUMB.mp4"
        poster="https://imagedelivery.net/LngsP1G4XrZYr43CIDhlJw/89bff98a-948b-48f6-c67e-cea1242c1800/public"
        href="/chulengo"
        title="Chulengo"
      />
      <VideoCard
        mp4="/Motion%20Thumbs/AWAY-WHERE%20-%20MOTION-THUMB.mp4"
        poster="https://imagedelivery.net/LngsP1G4XrZYr43CIDhlJw/4a97ae56-ed77-40b1-1491-241d8b558700/public"
        href="/away-where"
        title="Away Where"
      />
      <VideoCard
        mp4="/Motion%20Thumbs/YARBROUGH-WEDDING_MOTION-THUMB.mp4"
        poster="/Thumbnails/yarbrough-wedding_07.webp"
        href="/yarbrough-wedding"
        title="Yarbrough Wedding"
      />
      <VideoCard
        mp4="/Motion%20Thumbs/ALSO-TRUE_MOTION-THUMB.mp4"
        poster="https://imagedelivery.net/LngsP1G4XrZYr43CIDhlJw/6ea46e89-8244-431b-5586-037832455900/public"
        href="/also-true"
        title="Also True"
      />
    </div>
  </main>
</BaseLayout>

<style>
  .main {
    padding: 88px 32px 32px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 4px;
  }

  .placeholder {
    aspect-ratio: 16 / 9;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 4px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .main {
      padding: 68px 16px 16px;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
