---
import BaseLayout from "../layouts/BaseLayout.astro";
import VideoCard from "../components/VideoCard.astro";
import { projects } from "../data/projects";

const TOTAL_SLOTS = 10;
const placeholderCount = Math.max(0, TOTAL_SLOTS - projects.length);
---

<BaseLayout
  title="Work — Justin Rosengarten"
  description="Selected work by Justin Rosengarten, documentary editor."
  canonical="https://justinrosengarten.com/work"
>
  <main class="main">
    <div class="grid">
      {Array.from({ length: placeholderCount }).map(() => (
        <div class="placeholder" aria-hidden="true" />
      ))}
      {projects.map((p) => <VideoCard {...p} />)}
    </div>
  </main>
</BaseLayout>

<style>
  .main {
    padding: 88px 32px 32px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 4px;
  }

  .placeholder {
    aspect-ratio: 16 / 9;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 4px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .main {
      padding: 68px 16px 16px;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
