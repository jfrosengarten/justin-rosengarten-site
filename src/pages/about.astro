    alt: "Two people at a mixing desk in front of a screen showing The Earthwalker",
  },
  {
    src: "https://imagedelivery.net/LngsP1G4XrZYr43CIDhlJw/2c90b5db-94e0-430e-a202-930477d32300/public",
    alt: "Justin setting up a camera and lights in a living room",
  },
  {
    src: "https://imagedelivery.net/LngsP1G4XrZYr43CIDhlJw/ccef23bc-819f-44da-dd6c-1e0a40802100/public",
    alt: "A crew filming in a flowering garden on a sunny day",
    vertical: true,
  },
  {
    src: "https://imagedelivery.net/LngsP1G4XrZYr43CIDhlJw/4744d8bc-c28b-48dc-5999-64e2c16bd100/public",
    alt: "Justin watching a monitor on a snowy mountain shoot",
  },
  {
    src: "https://imagedelivery.net/LngsP1G4XrZYr43CIDhlJw/882b9525-9ead-4e5e-308e-560ae473b500/public",
