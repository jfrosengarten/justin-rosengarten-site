---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Justin Rosengarten"
  description="Documentary editor. Systems-minded. Story-first."
  canonical="https://justinrosengarten.com/"
>
  <section class="hero">
    <video autoplay muted loop playsinline preload="auto" class="hero-video">
      <source src="/Motion%20Thumbs/YARBROUGH-WEDDING_MOTION-THUMB.mp4" type="video/mp4" />
    </video>
  </section>
</BaseLayout>

<style>
  :global(body) {
    overflow-x: hidden;
  }

  .hero {
    position: relative;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>