---
/**
 * Editorial mosaic of stills for projects shown without a video. Images keep
 * their order and fall into a repeating 10-frame rhythm: a large frame with two
 * small ones beside it, two half-width frames, then the same mirrored. Clicking
 * a still opens it large in a viewer with previous/next.
 */
interface Props {
  title: string;
  /** Base paths; each has "-960.jpg" and "-1920.jpg" versions */
  stills: string[];
}

const { title, stills } = Astro.props;

// Placement within one 6-column, 6-row cycle: [column, colSpan, rowOffset, rowSpan]
const CYCLE: [number, number, number, number][] = [
  [1, 4, 0, 2], // large, left
  [5, 2, 0, 1], // small
  [5, 2, 1, 1], // small
  [1, 3, 2, 1], // half
  [4, 3, 2, 1], // half
  [1, 2, 3, 1], // small
  [1, 2, 4, 1], // small
  [3, 4, 3, 2], // large, right
  [1, 3, 5, 1], // half
  [4, 3, 5, 1], // half
];

const tiles = stills.map((base, i) => {
  const [col, colSpan, rowOffset, rowSpan] = CYCLE[i % CYCLE.length];
  const row = Math.floor(i / CYCLE.length) * 6 + rowOffset + 1;
  return {
    base,
    style: `--col: ${col} / span ${colSpan}; --row: ${row} / span ${rowSpan}; --m: ${i % 3 === 0 ? 2 : 1};`,
    large: colSpan === 4,
  };
});
---

<section class="gallery" aria-label={`${title} stills`}>
  {tiles.map((tile, i) => (
    <button
      type="button"
      class:list={["gallery-tile", { "is-large": tile.large }]}
      style={tile.style}
      data-index={i}
      aria-label={`View still ${i + 1} of ${stills.length}`}
    >
      <img
        src={`${tile.base}-960.jpg`}
        srcset={`${tile.base}-960.jpg 960w, ${tile.base}-1920.jpg 1920w`}
        sizes={tile.large ? "(max-width: 700px) 100vw, 66vw" : "(max-width: 700px) 50vw, 33vw"}
        alt=""
        width="960"
        height="540"
        loading={i < 3 ? "eager" : "lazy"}
        decoding="async"
      />
    </button>
  ))}
</section>

<dialog class="viewer" aria-label={`${title} stills`}>
  <div class="viewer-frame" tabindex="-1" autofocus>
    <img class="viewer-img" alt="" />
  </div>
  <div class="viewer-bar">
    <span class="viewer-count"><span class="viewer-index">01</span> / {String(stills.length).padStart(2, "0")}</span>
    <div class="viewer-nav">
      <button type="button" class="viewer-btn viewer-prev" aria-label="Previous still">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <button type="button" class="viewer-btn viewer-next" aria-label="Next still">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <button type="button" class="viewer-btn viewer-close" aria-label="Close">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
</dialog>

<script define:vars={{ stills }}>
  const dialog = document.querySelector("dialog.viewer");
  const img = dialog.querySelector(".viewer-img");
  const indexEl = dialog.querySelector(".viewer-index");
  const count = stills.length;
  let current = 0;

  const show = (i) => {
    current = (i + count) % count;
    img.src = `${stills[current]}-1920.jpg`;
    indexEl.textContent = String(current + 1).padStart(2, "0");
    // Warm the neighbours so stepping through feels instant
    [current + 1, current - 1].forEach((n) => {
      new Image().src = `${stills[(n + count) % count]}-1920.jpg`;
    });
  };

  document.querySelectorAll(".gallery-tile").forEach((tile) =>
    tile.addEventListener("click", () => {
      show(Number(tile.dataset.index));
      dialog.showModal();
      document.documentElement.classList.add("viewer-open");
    })
  );

  dialog.querySelector(".viewer-prev").addEventListener("click", () => show(current - 1));
  dialog.querySelector(".viewer-next").addEventListener("click", () => show(current + 1));
  dialog.querySelector(".viewer-close").addEventListener("click", () => dialog.close());

  dialog.addEventListener("keydown", (e) => {
    if (e.key === "ArrowRight") show(current + 1);
    if (e.key === "ArrowLeft") show(current - 1);
  });

  // Clicking the dark area around the image closes the viewer
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog || e.target.classList.contains("viewer-frame")) dialog.close();
  });

  dialog.addEventListener("close", () => document.documentElement.classList.remove("viewer-open"));
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 4px;
  }

  .gallery-tile {
    grid-column: var(--col);
    grid-row: var(--row);
    position: relative;
    padding: 0;
    border: none;
    border-radius: 4px;
    overflow: hidden;
    background: #000;
    cursor: zoom-in;
  }

  .gallery-tile img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1), filter 300ms ease;
  }

  .gallery-tile:hover img {
    transform: scale(1.03);
  }

  .gallery-tile:focus-visible {
    outline: 1px solid rgba(255, 220, 80, 0.7);
    outline-offset: 2px;
  }

  /* Phones: two columns, every third still full width */
  @media (max-width: 700px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gallery-tile {
      grid-column: auto / span var(--m);
      grid-row: auto;
    }
  }

  /* ── Viewer ── */
  :global(html.viewer-open) {
    overflow: hidden;
  }

  .viewer {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
  }

  .viewer::backdrop {
    background: rgba(7, 3, 15, 0.94);
  }

  .viewer[open] {
    display: flex;
    flex-direction: column;
    animation: viewer-fade 220ms ease;
  }

  .viewer-frame {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 24px 0;
  }

  .viewer-frame:focus {
    outline: none;
  }

  .viewer-img {
    max-width: 100%;
    max-height: 100%;
    border-radius: 2px;
    object-fit: contain;
  }

  .viewer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px 20px;
    font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
  }

  .viewer-count {
    font-size: 10px;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
    color: rgba(255, 255, 255, 0.45);
  }

  .viewer-index {
    color: rgba(255, 255, 255, 0.9);
  }

  .viewer-nav {
    display: flex;
    gap: 10px;
  }

  .viewer-btn {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    background: transparent;
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .viewer-btn:hover {
    color: rgba(255, 220, 80, 0.9);
    border-color: rgba(255, 220, 80, 0.6);
  }

  .viewer-btn:focus-visible {
    outline: 1px solid rgba(255, 220, 80, 0.6);
    outline-offset: 3px;
  }

  @keyframes viewer-fade {
    from { opacity: 0; }
  }

  @media (max-width: 600px) {
    .viewer-frame {
      padding: 12px 12px 0;
    }

    .viewer-bar {
      padding: 12px 16px 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-tile img {
      transition: none;
    }

    .gallery-tile:hover img {
      transform: none;
    }

    .viewer[open] {
      animation: none;
    }
  }
</style>
