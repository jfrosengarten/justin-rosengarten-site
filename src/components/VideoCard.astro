---
interface Props {
  mp4: string;
  webm?: string;
  poster: string;
  href: string;
  title: string;
  /** Justin's role, shown under the title on hover */
  role?: string;
}

const { mp4, webm, poster, href, title, role } = Astro.props;
---

<a class="vc" href={href} aria-label={role ? `Watch ${title}, ${role}` : `Watch ${title}`}>
  <img class="vc-poster" src={poster} alt="" />
  <video class="vc-video" muted loop playsinline preload="none">
    <source src={mp4} type="video/mp4" />
    {webm && <source src={webm} type="video/webm" />}
  </video>
  <div class="vc-caption" aria-hidden="true">
    <span class="vc-title">{title}</span>
    {role && <span class="vc-role">{role}</span>}
  </div>
</a>

<script>
  function initVideoCards() {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLAnchorElement>('.vc').forEach(card => {
      const video = card.querySelector<HTMLVideoElement>('.vc-video');
      if (!video || reducedMotion) return;

      card.addEventListener('mouseenter', () => { video.play(); });
      card.addEventListener('mouseleave', () => { video.pause(); video.currentTime = 0; });
    });
  }

  document.addEventListener('astro:page-load', initVideoCards);
  initVideoCards();
</script>

<style>
  .vc {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 4px;
    background: #07030f;
    cursor: pointer;
  }

  .vc-poster,
  .vc-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: none;
  }

  .vc-video {
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .vc:hover .vc-video {
    opacity: 1;
  }

  /* Caption: a soft fade from the bottom, then title and role rise into place */
  .vc::after {
    content: "";
    position: absolute;
    inset: 40% 0 0 0;
    background: linear-gradient(to top, rgba(7, 3, 15, 0.8), rgba(7, 3, 15, 0));
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }

  .vc-caption {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 12px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 300ms ease, transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .vc-title {
    font-size: 14px;
    line-height: 1.2;
    color: rgba(255, 255, 255, 0.96);
  }

  .vc-role {
    font-size: 9px;
    line-height: 1.3;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  .vc:hover::after,
  .vc:focus-visible::after,
  .vc:hover .vc-caption,
  .vc:focus-visible .vc-caption {
    opacity: 1;
  }

  .vc:hover .vc-caption,
  .vc:focus-visible .vc-caption {
    transform: none;
    transition-delay: 60ms;
  }

  .vc:focus-visible {
    outline: 1px solid rgba(255, 220, 80, 0.7);
    outline-offset: 2px;
  }

  /* Touch screens can't hover: keep the caption visible */
  @media (hover: none) {
    .vc::after,
    .vc-caption {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vc-caption {
      transform: none;
      transition: opacity 300ms ease;
    }
  }
</style>
