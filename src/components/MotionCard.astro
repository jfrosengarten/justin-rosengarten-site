---
interface Props {
  mp4: string;
  webm?: string;
  poster?: string;
  streamUid: string;
  customerCode: string;
  title: string;
}

const { mp4, webm, poster, streamUid, customerCode, title } = Astro.props;

const resolvedPoster =
  poster ??
  `https://customer-${customerCode}.cloudflarestream.com/${streamUid}/thumbnails/thumbnail.jpg?time=3s`;

const iframeSrc =
  `https://customer-${customerCode}.cloudflarestream.com/${streamUid}/iframe?autoplay=true&muted=false`;
---

<div class="mc" data-iframe-src={iframeSrc}>
  <video
    class="mc-loop"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={resolvedPoster}
  >
    <source src={mp4} type="video/mp4" />
    {webm && <source src={webm} type="video/webm" />}
  </video>
  <button class="mc-play" aria-label={`Play ${title}`}>
    <svg viewBox="0 0 80 80" fill="none" aria-hidden="true">
      <circle cx="40" cy="40" r="39" stroke="rgba(255,255,255,0.25)" stroke-width="1"/>
      <path d="M33 27l22 13-22 13V27z" fill="white"/>
    </svg>
  </button>
</div>

<script>
  function initCards() {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('.mc').forEach(card => {
      const video = card.querySelector<HTMLVideoElement>('.mc-loop');
      const btn   = card.querySelector<HTMLButtonElement>('.mc-play');
      const src   = card.dataset.iframeSrc!;

      if (reducedMotion && video) {
        video.pause();
        video.removeAttribute('autoplay');
      }

      btn?.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = src;
        iframe.allow = 'autoplay; fullscreen; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.className = 'mc-iframe';
        card.innerHTML = '';
        card.appendChild(iframe);
      });
    });
  }

  document.addEventListener('astro:page-load', initCards);
  initCards();
</script>

<style>
  .mc {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #07030f;
    border-radius: 4px;
  }

  .mc-loop,
  .mc-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: none;
    display: block;
  }

  /* Full-card clickable overlay */
  .mc-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .mc-play svg {
    width: 64px;
    height: 64px;
    filter: drop-shadow(0 2px 12px rgba(0, 0, 0, 0.7));
    transition: transform 160ms ease, opacity 160ms ease;
    opacity: 0.85;
  }

  .mc-play:hover svg,
  .mc-play:focus-visible svg {
    transform: scale(1.08);
    opacity: 1;
  }

  .mc-play:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.6);
    outline-offset: -3px;
  }
</style>
