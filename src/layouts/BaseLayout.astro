---
import "../styles/global.css";

const {
  title = "Justin Rosengarten",
  description = "Personal site for Justin Rosengarten.",
  canonical = "https://justinrosengarten.com/",
  ogImage,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <meta name="twitter:card" content="summary_large_image" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="stylesheet" href="https://use.typekit.net/zto4gpp.css" />
  </head>

  <body>
    <!-- Desktop header -->
    <header class="site-header">
      <div class="header-col identity-col">
        <a href="/" class="home-name">Justin Rosengarten</a>
        <div class="identity-info">
          <a href="mailto:justin.rosengarten@gmail.com" class="contact-group">
            <span class="contact-label">Contact</span>
            <span class="home-email">justin.rosengarten@gmail.com</span>
          </a>
        </div>
      </div>
      <a href="/work" class="header-col nav-link">Work</a>
      <a href="/about" class="header-col nav-link">About</a>
    </header>

    <!-- Mobile header -->
    <div class="mobile-header">
      <button class="menu-toggle" aria-expanded="false" aria-label="Toggle menu">
        <span class="menu-text">Menu</span>
        <span class="menu-icon">+</span>
      </button>
      <nav class="mobile-menu" aria-hidden="true">
        <a href="/" class="mobile-menu-item">Home</a>
        <a href="/work" class="mobile-menu-item">Work</a>
        <a href="/about" class="mobile-menu-item">About</a>
      </nav>
    </div>

    <slot />

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-rule"></div>
        <div class="footer-cols">

          <div class="footer-col">
            <p class="footer-label">Contact</p>
            <a href="mailto:justin.rosengarten@gmail.com" class="f-link">
              <span class="f-roll">
                <span>justin.rosengarten@gmail.com</span>
                <span aria-hidden="true">justin.rosengarten@gmail.com</span>
              </span>
            </a>
          </div>

          <div class="footer-col">
            <div class="footer-social">
              <a href="https://www.instagram.com/justinrosengarten/" target="_blank" rel="noopener noreferrer" class="footer-icon-link" aria-label="Instagram">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                  <circle cx="12" cy="12" r="4"/>
                  <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
                </svg>
              </a>
              <a href="https://www.linkedin.com/in/justin-rosengarten/" target="_blank" rel="noopener noreferrer" class="footer-icon-link" aria-label="LinkedIn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
            </div>
          </div>

        </div>
        <div class="footer-rule"></div>
        <div class="footer-copyright">
          <span>© <span class="footer-year">{new Date().getFullYear()}</span> Justin Rosengarten</span>
          <span>New York, NY</span>
        </div>
      </div>
    </footer>

    <script>
      document.querySelectorAll(".footer-year").forEach((el) => {
        el.textContent = String(new Date().getFullYear());
      });
    </script>

  </body>
</html>

<script>
  const toggle = document.querySelector('.menu-toggle') as HTMLButtonElement;
  const menu = document.querySelector('.mobile-menu') as HTMLElement;
  const icon = document.querySelector('.menu-icon') as HTMLElement;

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    menu.setAttribute('aria-hidden', String(isOpen));
    icon.textContent = isOpen ? '+' : '–';
    menu.classList.toggle('is-open', !isOpen);
  });
</script>

<style>
  /* ── SHARED ── */
  .mobile-header { display: none; }
  .mobile-menu   { display: none; }

  .mobile-menu.is-open {
    display: flex;
    flex-direction: column;
  }

  /* ── DESKTOP (769px+) ── */
  @media (min-width: 769px) {
    .site-header {
      position: fixed;
      top: 20px;
      left: 0;
      right: 0;
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 0 32px;
      z-index: 100;
      /* Let hovers/clicks pass through the header's empty space to content below */
      pointer-events: none;
    }

    .site-header a {
      pointer-events: auto;
    }

    .header-col {
      flex: 1;
      border-top: 1px solid rgba(255, 255, 255, 0.5);
      padding: 8px 0 20px 0;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .identity-col {
      flex: 1;
      flex-direction: row;
      align-items: flex-start;
      gap: 10px;
    }

    .home-name {
      font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
      font-weight: 800;
      font-size: 14px;
      letter-spacing: 0.12em;
      color: rgba(255, 255, 255, 0.92);
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      white-space: nowrap;
      align-self: stretch;
      transition: opacity 150ms ease;
    }

    .home-name:hover { opacity: 0.65; }


    .identity-info {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding-top: 2px;
    }

    .contact-group {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .contact-label {
      font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
      font-size: 13px;
      font-weight: 400;
      letter-spacing: 0.01em;
      color: rgba(255, 255, 255, 0.55);
      transition: color 150ms ease;
    }

    .contact-group:hover .contact-label {
      color: rgba(255, 255, 255, 0.92);
    }

    .contact-group:hover .home-email {
      color: rgba(255, 220, 80, 0.85);
    }

    .home-email {
      font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 0.01em;
      color: rgba(255, 255, 255, 0.45);
      transition: color 150ms ease;
    }

    .nav-link {
      font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
      font-size: 13px;
      font-weight: 400;
      letter-spacing: 0.01em;
      color: rgba(255, 255, 255, 0.55);
      transition: color 150ms ease;
    }

    .nav-link:hover,
    .nav-link.active { color: rgba(255, 255, 255, 0.92); }
  }

  /* ── MOBILE (≤768px) ── */
  @media (max-width: 768px) {
    .site-header { display: none; }

    .mobile-header {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
    }

    .menu-toggle {
      display: flex;
      align-items: center;
      gap: 6px;
      background: none;
      border: none;
      border-top: 1px solid rgba(255, 255, 255, 0.5);
      padding: 16px 20px;
      cursor: pointer;
      width: 100%;
      text-align: left;
    }

    .menu-text {
      font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
      font-size: 14px;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.75);
      letter-spacing: 0.03em;
    }

    .menu-icon {
      font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
      font-size: 18px;
      font-weight: 300;
      color: rgba(255, 255, 255, 0.75);
      line-height: 1;
    }

    .mobile-menu-item {
      font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
      font-size: 15px;
      font-weight: 300;
      color: rgba(255, 255, 255, 0.75);
      letter-spacing: 0.03em;
      padding: 16px 20px;
      position: relative;
      transition: color 150ms ease;
    }

    .mobile-menu-item::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 20px;
      right: 20px;
      height: 2px;
      background: rgba(255, 255, 255, 0.5);
    }

    .mobile-menu-item:hover { color: rgba(255, 255, 255, 0.92); }

    .mobile-menu {
      background: transparent;
    }
  }

  /* ── FOOTER ── */
  .site-footer {
    background: #fff;
    color: #0a0a0a;
    font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
  }

  .footer-inner {
    padding: 0 32px;
  }

  .footer-rule {
    height: 1px;
    background: rgba(0, 0, 0, 0.1);
  }

  .footer-cols {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 0;
  }

  .footer-label {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.38);
    margin: 0 0 10px;
  }

  /* Rollover text effect */
  .f-link {
    display: inline-block;
    text-decoration: none;
    color: #0a0a0a;
    font-size: 13px;
    letter-spacing: 0.01em;
  }

  .f-roll {
    display: inline-flex;
    flex-direction: column;
    overflow: hidden;
    height: 1.3em;
  }

  .f-roll > span {
    display: block;
    line-height: 1.3;
    white-space: nowrap;
    transition: transform 400ms cubic-bezier(0.76, 0, 0.24, 1);
  }

  .f-link:hover .f-roll > span {
    transform: translateY(-100%);
  }

  /* Social icons */
  .footer-social {
    display: flex;
    gap: 20px;
    align-items: center;
  }

  .footer-icon-link {
    color: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer-icon-link:hover {
    color: rgba(255, 220, 80, 0.85);
  }

  /* Copyright row */
  .footer-copyright {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    font-size: 11px;
    color: rgba(0, 0, 0, 0.35);
    letter-spacing: 0.02em;
  }

  @media (max-width: 640px) {
    .footer-inner { padding: 0 20px; }
    .footer-cols  { flex-direction: column; align-items: flex-start; gap: 24px; }
  }
</style>
